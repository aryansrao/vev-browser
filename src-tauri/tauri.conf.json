{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vev",
  "version": "0.1.0",
  "identifier": "com.vev.browser",
  "build": {
    "frontendDist": "../src"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vev",
        "width": 1280,
        "height": 820,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
